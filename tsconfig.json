{
  "compilerOptions": {
    "target": "ES2015",
    "lib": ["dom", "dom.iterable", "esnext"],
    "paths": {
      "src/*": ["./src/*"],
      "db": ["./db"],
      "integrations/*": ["./integrations/*"],
      "mailers/*": ["./mailers/*"],
      "types": ["./types.ts"],
      "test/*": ["./test/*"]
    },
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo"
  },
  "exclude": ["node_modules", "**/*.e2e.ts", "cypress"],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "types",
    "integrations/mailer.js",
    "src/summary/utils/viewerWorker.js",
    "src/summary/utils/viewerQueue.js"
  ]
}
